{
  "_comment": "Lines for zn-gate scan in Node.js and Python (test/scan_secrets.test.js, tests/test_scan_secrets.py). {V} and {S} are invented values that the tests assemble at runtime: {V} is ZNTESTFAKE plus a fixed suffix, {S} the same with ( ) { } [ ] < > ; | and a backslash. rules lists the secret rules each line must report, in any order; an empty list means no secret.",
  "samples": [
    { "text": "mytool --api-key={V}", "rules": ["secret:cli_credential_flag"] },
    { "text": "mytool --password='{V}' --verbose", "rules": ["secret:cli_credential_flag"] },
    { "text": "deploy --token={V} --region eu-west-1", "rules": ["secret:cli_credential_flag"] },
    { "text": "mytool --password=-{V}", "rules": ["secret:cli_credential_flag"] },
    { "text": "mytool --client-secret=@{V}", "rules": ["secret:cli_credential_flag"] },
    { "text": "api_key := \"{V}\"", "rules": ["secret:credential_assignment"] },
    { "text": "'password' => '{V}',", "rules": ["secret:credential_assignment"] },
    { "text": "$password = \"{V}\";", "rules": ["secret:credential_assignment"] },
    { "text": "const dbPassword = \"{V}\";", "rules": ["secret:credential_assignment"] },
    { "text": "password = \"{S}\"", "rules": ["secret:credential_assignment"] },
    { "text": "DB_PASSWORD={S}", "rules": ["secret:prefixed_credential"] },
    { "text": "DB_PASSWORD=!{V}", "rules": ["secret:prefixed_credential"] },
    { "text": "DB_PASSWORD=@{V}", "rules": ["secret:prefixed_credential"] },
    { "text": "curl -H \"Authorization: Bearer {V}\" https://api.example.com/v1", "rules": ["secret:bearer_token"] },
    { "text": "git clone https://deploy:{V}@git.example.com/org/repo.git", "rules": ["secret:url_password"] },
    { "text": "git remote add origin ssh://deploy:{V}@git.example.com/org/repo.git", "rules": ["secret:url_password"] },
    { "text": "mytool --password=", "rules": [] },
    { "text": "mytool --password=$DB_PASSWORD", "rules": [] },
    { "text": "mytool --token=<your-token>", "rules": [] },
    { "text": "mytool --api-key=${API_KEY}", "rules": [] },
    { "text": "mytool --password=changeme", "rules": [] },
    { "text": "'password' => null,", "rules": [] },
    { "text": "'password' => 'Contraseña',", "rules": [] },
    { "text": "\"resetPassword\": \"Restablecer\",", "rules": [] },
    { "text": "if (token == \"{V}\") {", "rules": [] },
    { "text": "password: \"${DB_PASSWORD}\"", "rules": [] },
    { "text": "token: \"{{ secrets.API_TOKEN }}\"", "rules": [] },
    { "text": "const token = getToken();", "rules": [] },
    { "text": "git clone https://git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://user:password@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://$TOKEN:x-oauth-basic@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://${GIT_USER}:{V}@git.example.com/org/repo.git", "rules": ["secret:url_password"] },
    { "text": "git clone https://$GIT_USER:{V}@git.example.com/org/repo.git", "rules": ["secret:url_password"] },
    { "text": "git clone https://x-access-token:{V}@git.example.com/org/repo.git", "rules": ["secret:url_password"] },
    { "text": "git clone https://deploy:%GIT_PASSWORD%@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://deploy:${GIT_PASSWORD}@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://deploy:$GIT_PASSWORD@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://deploy:<password>@git.example.com/org/repo.git", "rules": [] },
    { "text": "git clone https://deploy:{{git_password}}@git.example.com/org/repo.git", "rules": [] },
    { "text": "curl -H \"Authorization: Bearer __ZN_GITHUB_TOKEN__\" https://api.example.com/v1", "rules": [] },
    { "text": "Authorization: Bearer $TOKEN", "rules": [] },
    { "text": "Authorization: Bearer <token>", "rules": [] }
  ]
}
